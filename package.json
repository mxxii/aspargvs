{
  "name": "aspargvs",
  "version": "0.7.0",
  "description": "Parse argv as json object",
  "keywords": [
    "arg",
    "parser",
    "arg-parser",
    "json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxxii/aspargvs.git"
  },
  "bugs": {
    "url": "https://github.com/mxxii/aspargvs/issues"
  },
  "homepage": "https://github.com/mxxii/aspargvs",
  "author": "KillyMXI",
  "funding": "https://ko-fi.com/killymxi",
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/aspargvs.d.mts",
        "default": "./lib/aspargvs.mjs"
      },
      "require": {
        "types": "./lib/aspargvs.d.cts",
        "default": "./lib/aspargvs.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "main": "./lib/aspargvs.cjs",
  "module": "./lib/aspargvs.mjs",
  "types": "./lib/aspargvs.d.cts",
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build:docs": "typedoc --plugin typedoc-plugin-markdown",
    "build:rollup": "rollup -c",
    "build:types": "tsc --declaration --emitDeclarationOnly",
    "build": "npm run clean && npm run build:rollup && npm run build:types && npm run build:docs",
    "checkAll": "npm run lint && npm test",
    "clean": "rimraf lib",
    "example": "node ./example/example.mjs",
    "lint:eslint": "eslint .",
    "lint:md": "markdownlint-cli2",
    "lint": "npm run lint:eslint && npm run lint:md",
    "prepublishOnly": "npm run build && npm run checkAll",
    "test": "ava"
  },
  "dependencies": {
    "peberminta": "~0.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^20.19.39",
    "@types/test-console": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "ava": "^7.0.0",
    "deepmerge": "^4.3.1",
    "eslint": "^10.2.1",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.5.0",
    "markdownlint-cli2": "0.22.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.2",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-dts": "^6.4.1",
    "test-console": "^2.0.0",
    "ts-blank-space": "^0.8.0",
    "tslib": "^2.8.1",
    "typedoc": "~0.28.19",
    "typedoc-plugin-markdown": "~4.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "ava": {
    "extensions": {
      "ts": "module"
    },
    "files": [
      "test/**/*"
    ],
    "nodeArguments": [
      "--import=ts-blank-space/register"
    ],
    "verbose": true
  }
}
